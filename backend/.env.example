# Backend server
PORT=5000
NODE_ENV=development

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=online_exam_system

# Frontend origin
FRONTEND_URL=http://localhost:5173

# Generate a long, random secret for your own environment.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
